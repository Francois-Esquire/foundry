{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  // `--affected` selects a task when a changed file matches its `inputs`, so
  // a task whose inputs reach outside its package, such as Spyglass's tests
  // reading its CLI reference in the docs, runs when that file changes.
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", ".cache/tsbuildinfo.json"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "test:package": {
      "dependsOn": ["build"],
      "cache": false
    },
    "docs:build": {
      "outputs": ["dist/**", ".blume/**"],
      "cache": false
    },
    "docs:dev": {
      "cache": false,
      "persistent": true
    },
    "docs:check": {
      "outputs": []
    }
  },
  "globalEnv": ["CI", "NODE_ENV"],
  "globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
