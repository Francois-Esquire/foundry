{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", ".cache/tsbuildinfo.json"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "test:package": {
      "dependsOn": ["build"],
      "cache": false
    },
    "//#docs:build": {
      "inputs": ["docs/**", "blume.config.ts", "package.json", "bun.lock"],
      "outputs": ["dist/**", ".blume/**"],
      "cache": false
    },
    "//#docs:dev": {
      "cache": false,
      "persistent": true
    },
    "//#docs:check": {
      "inputs": ["docs/**", "blume.config.ts", "package.json", "bun.lock"],
      "outputs": []
    },
    "//#docs:typecheck": {
      "cache": false,
      "outputs": []
    }
  },
  "globalEnv": ["CI", "NODE_ENV"],
  "globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
