{
  "name": "@foundry/prompts",
  "version": "0.1.0",
  "private": true,
  "description": "Prompt dialects for CLI harnesses: parse what a prompt references, check it against a catalog, and write it for each harness.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "clean": "rm -rf .cache .turbo coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foundry/core": "workspace:*"
  },
  "devDependencies": {
    "@foundry/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
