          },
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "default": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "minimum": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": false
          }
        }
