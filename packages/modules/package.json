{
  "name": "@foundry/modules",
  "version": "0.1.0",
  "private": true,
  "description": "Module domain, registry and store, package, Gateway, and workspace composition contracts",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./gateway": {
      "types": "./dist/gateway/index.d.ts",
      "import": "./src/gateway/index.ts",
      "default": "./src/gateway/index.ts"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./src/node/index.ts",
      "default": "./src/node/index.ts"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "import": "./src/platform/index.ts",
      "default": "./src/platform/index.ts"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./src/sdk/index.ts",
      "default": "./src/sdk/index.ts"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./src/store/index.ts",
      "default": "./src/store/index.ts"
    },
    "./store/memory": {
      "types": "./dist/store/memory.d.ts",
      "import": "./src/store/memory.ts",
      "default": "./src/store/memory.ts"
    },
    "./store/sqlite": {
      "types": "./dist/store/sqlite.d.ts",
      "import": "./src/store/sqlite.ts",
      "default": "./src/store/sqlite.ts"
    },
    "./store/tables": {
      "types": "./dist/store/tables.d.ts",
      "import": "./src/store/tables.ts",
      "default": "./src/store/tables.ts"
    },
    "./template": {
      "types": "./dist/template/index.d.ts",
      "import": "./src/template/index.ts",
      "default": "./src/template/index.ts"
    },
    "./testing/store": {
      "types": "./dist/testing/store.d.ts",
      "import": "./src/testing/store.ts",
      "default": "./src/testing/store.ts"
    }
  },
  "files": [
    "./dist/**/*",
    "./schema/**/*",
    "./src/**/*",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .cache .turbo coverage",
    "emit-manifest-schema": "bun scripts/emit-manifest-schema.ts && biome format --write schema/foundry.module.schema.json",
    "emit-sdk": "bun scripts/emit-sdk.ts",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foundry/artifacts": "workspace:*",
    "@foundry/core": "workspace:*",
    "@foundry/lib": "workspace:*",
    "@foundry/sandbox": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@foundry/tsconfig": "workspace:*",
    "@libsql/client": "^0.18.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-orm": "^0.45.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.4"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  }
}
