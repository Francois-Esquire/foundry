{
  "name": "@foundry/usage",
  "version": "0.1.0",
  "private": true,
  "description": "Usage as it is now, per AI provider account: limits across allowance, metered, prepaid, and credits billing, and consumption read from each client's own history.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./provider": {
      "types": "./src/provider.ts",
      "import": "./src/provider.ts"
    },
    "./providers/anthropic": {
      "types": "./src/providers/anthropic/index.ts",
      "import": "./src/providers/anthropic/index.ts"
    },
    "./providers/openai": {
      "types": "./src/providers/openai/index.ts",
      "import": "./src/providers/openai/index.ts"
    }
  },
  "scripts": {
    "clean": "rm -rf .cache .turbo coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foundry/models": "workspace:*"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.205",
    "@foundry/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.205"
  }
}
