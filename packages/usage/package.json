{
  "name": "@foundry/usage",
  "version": "0.1.0",
  "private": true,
  "description": "Usage as it is now, per AI provider account: limits across allowance, metered, prepaid, and credits billing, and consumption read from each client's own history.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./src/node.ts",
      "default": "./src/node.ts"
    },
    "./provider": {
      "types": "./src/provider.ts",
      "import": "./src/provider.ts",
      "default": "./src/provider.ts"
    },
    "./providers/anthropic": {
      "types": "./src/providers/anthropic.ts",
      "import": "./src/providers/anthropic.ts",
      "default": "./src/providers/anthropic.ts"
    },
    "./providers/openai": {
      "types": "./src/providers/openai.ts",
      "import": "./src/providers/openai.ts",
      "default": "./src/providers/openai.ts"
    }
  },
  "scripts": {
    "clean": "rm -rf .cache .turbo coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foundry/lib": "workspace:*",
    "@foundry/models": "workspace:*"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.330",
    "@foundry/tsconfig": "workspace:*",
    "@types/bun": "1.4.5",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.330"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  }
}
