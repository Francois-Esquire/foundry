{
  "name": "@foundry/core",
  "version": "0.1.0",
  "private": true,
  "description": "Foundry core.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./src/agents/index.ts",
      "default": "./src/agents/index.ts"
    },
    "./pagination": {
      "types": "./dist/pagination.d.ts",
      "import": "./src/pagination.ts",
      "default": "./src/pagination.ts"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./src/storage.ts",
      "default": "./src/storage.ts"
    },
    "./testing/storage": {
      "types": "./dist/testing/storage.d.ts",
      "import": "./src/testing/storage.ts",
      "default": "./src/testing/storage.ts"
    }
  },
  "files": [
    "./dist/**/*",
    "./src/**/*",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist .cache .turbo coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.7",
    "@foundry/tsconfig": "workspace:*",
    "@types/bun": "1.4.4",
    "ai": "7.0.58",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "4.0.7",
    "ai": "7.0.58"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/provider": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  }
}
