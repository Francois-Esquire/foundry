{
  "name": "@foundry/models",
  "version": "0.1.0",
  "private": true,
  "description": "Unified model registry: remote providers, CLI harnesses, on-device models, and their catalogs behind one Models registry.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts"
    },
    "./fal": {
      "types": "./dist/src/fal/provider.d.ts",
      "import": "./src/fal/provider.ts"
    },
    "./live": {
      "types": "./dist/src/live/index.d.ts",
      "import": "./src/live/index.ts"
    },
    "./live/node": {
      "types": "./dist/src/live/node/index.d.ts",
      "import": "./src/live/node/index.ts"
    },
