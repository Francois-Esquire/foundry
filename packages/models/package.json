{
  "name": "@foundry/models",
  "version": "0.0.1",
  "private": true,
  "description": "Unified model package \u2014 local model lifecycle (download/cache/load) + remote provider registry. Hosts ModelManager today; local model loading lands here as the package matures.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "import": "./src/*.ts"
    },
    "./catalog": {
      "types": "./dist/src/catalog/index.d.ts",
      "import": "./src/catalog/index.ts"
    },
    "./fal": {
      "types": "./dist/src/fal/provider.d.ts",
      "import": "./src/fal/provider.ts"
    },
    "./local": {
      "types": "./dist/src/local/index.d.ts",
      "import": "./src/local/index.ts"
    },
    "./embeddings": {
      "types": "./dist/src/embeddings/index.d.ts",
      "import": "./src/embeddings/index.ts"
    },
    "./live": {
      "types": "./dist/src/live/index.d.ts",
      "import": "./src/live/index.ts"
    },
    "./live/node": {
      "types": "./dist/src/live/node/index.d.ts",
      "import": "./src/live/node/index.ts"
    }
  },
  "files": [
    "./dist/src/**/*",
    "./src/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist .cache .turbo coverage",
    "sync:models-dev": "bun scripts/sync-models-dev.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/fal": "3.0.26",
    "@ai-sdk/openai-compatible": "3.0.27",
    "@ai-sdk/provider": "4.0.7",
    "@ai-sdk/provider-utils": "5.0.25",
    "@ai-sdk/replicate": "3.0.26",
    "@browser-ai/transformers-js": "3.0.0",
    "@chonkiejs/core": "^0.0.11",
    "@fal-ai/client": "1.11.0-alpha.2",
    "@foundry/agents": "workspace:*",
    "@foundry/lib": "workspace:*",
    "@huggingface/transformers": "^4.2.0",
    "@kreuzberg/node": "^4.10.2",
    "@kreuzberg/tree-sitter-language-pack": "^1.10.9",
    "ai": "7.0.58",
    "ai-sdk-provider-claude-code": "4.0.1",
    "ai-sdk-provider-codex-cli": "2.1.2",
    "evlog": "^2.25.0",
    "werift": "0.24.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@foundry/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.9",
    "happy-dom": "^20.11.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
