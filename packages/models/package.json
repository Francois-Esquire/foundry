{
  "name": "@foundry/models",
  "version": "0.1.0",
  "private": true,
  "description": "One catalog-checked Models registry over gateway, Vercel and CLI harness providers, with their catalogs and costs.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./providers/claude-code": {
      "types": "./dist/src/providers/claude-code.d.ts",
      "import": "./src/providers/claude-code.ts",
      "default": "./src/providers/claude-code.ts"
    },
    "./providers/codex": {
      "types": "./dist/src/providers/codex.d.ts",
      "import": "./src/providers/codex.ts",
      "default": "./src/providers/codex.ts"
    },
    "./providers/pi": {
      "types": "./dist/src/providers/pi.d.ts",
      "import": "./src/providers/pi.ts",
      "default": "./src/providers/pi.ts"
    },
    "./providers/gateway": {
      "types": "./dist/src/providers/gateway.d.ts",
      "import": "./src/providers/gateway.ts",
      "default": "./src/providers/gateway.ts"
    },
    "./providers/vercel": {
      "types": "./dist/src/providers/vercel.d.ts",
      "import": "./src/providers/vercel.ts",
      "default": "./src/providers/vercel.ts"
    },
    "./cost": {
      "types": "./dist/src/cost.d.ts",
      "import": "./src/cost.ts",
      "default": "./src/cost.ts"
    },
    "./catalog/models-dev": {
      "types": "./dist/src/catalog/models-dev.d.ts",
      "import": "./src/catalog/models-dev.ts",
      "default": "./src/catalog/models-dev.ts"
    },
    "./catalog/models-dev-source": {
      "types": "./dist/src/catalog/models-dev-source.d.ts",
      "import": "./src/catalog/models-dev-source.ts",
      "default": "./src/catalog/models-dev-source.ts"
    }
  },
  "files": [
    "./dist/src/**/*",
    "./src/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .cache .turbo coverage",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:pi": "vitest run --project pi",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.27",
    "@ai-sdk/provider": "4.0.7",
    "@foundry/core": "workspace:*",
    "@foundry/lib": "workspace:*",
    "ai": "7.0.58",
    "evlog": "^2.25.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@foundry/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "ai-sdk-provider-claude-code": "4.0.1",
    "ai-sdk-provider-codex-cli": "2.1.2",
    "ai-sdk-provider-pi": "0.1.0"
  }
}
