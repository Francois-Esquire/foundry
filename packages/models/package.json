  "files": [
    "./dist/src/**/*",
    "./src/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist .cache .turbo coverage",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:pi": "vitest run --project pi",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/fal": "3.0.26",
    "@ai-sdk/openai-compatible": "3.0.27",
    "@ai-sdk/provider": "4.0.7",
    "@ai-sdk/provider-utils": "5.0.25",
    "@ai-sdk/replicate": "3.0.26",
    "@browser-ai/transformers-js": "3.0.0",
    "@chonkiejs/core": "^0.0.11",
    "@fal-ai/client": "1.11.0-alpha.2",
    "@foundry/core": "workspace:*",
    "@foundry/lib": "workspace:*",
    "@huggingface/transformers": "^4.2.0",
    "@kreuzberg/tree-sitter-language-pack": "^1.10.9",
    "ai": "7.0.58",
    "evlog": "^2.25.0",
    "werift": "0.24.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@foundry/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.9",
    "happy-dom": "^20.11.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
