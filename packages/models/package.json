      "types": "./dist/src/airplane.d.ts",
      "import": "./src/airplane.ts"
    },
    "./claude-code": {
      "types": "./dist/src/claude-code.d.ts",
      "import": "./src/claude-code.ts"
    },
    "./codex": {
      "types": "./dist/src/codex.d.ts",
      "import": "./src/codex.ts"
    },
    "./pi": {
      "types": "./dist/src/pi.d.ts",
      "import": "./src/pi.ts"
