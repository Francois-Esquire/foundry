{
  "name": "@foundry/models",
  "version": "0.0.1",
  "private": true,
  "description": "Unified model registry: remote providers, CLI harnesses, on-device models, and their catalogs behind one ModelManager.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts"
    },
    "./fal": {
      "types": "./dist/src/fal/provider.d.ts",
      "import": "./src/fal/provider.ts"
    },
    "./live": {
      "types": "./dist/src/live/index.d.ts",
      "import": "./src/live/index.ts"
    },
    "./live/node": {
      "types": "./dist/src/live/node/index.d.ts",
      "import": "./src/live/node/index.ts"
    },
    "./claude-code": {
      "types": "./dist/src/claude-code.d.ts",
      "import": "./src/claude-code.ts"
    },
    "./codex": {
      "types": "./dist/src/codex.d.ts",
      "import": "./src/codex.ts"
    },
    "./local": {
      "types": "./dist/src/local/provider.d.ts",
      "import": "./src/local/provider.ts"
    },
    "./local/remote": {
      "types": "./dist/src/local/remote/transport.d.ts",
      "import": "./src/local/remote/transport.ts"
    },
    "./local/remote/provider": {
      "types": "./dist/src/local/remote/provider.d.ts",
      "import": "./src/local/remote/provider.ts"
    },
    "./gateway": {
      "types": "./dist/src/gateway.d.ts",
      "import": "./src/gateway.ts"
    },
    "./vercel": {
      "types": "./dist/src/vercel.d.ts",
      "import": "./src/vercel.ts"
    },
    "./replicate": {
      "types": "./dist/src/replicate.d.ts",
      "import": "./src/replicate.ts"
    },
    "./model-option": {
      "types": "./dist/src/model-option.d.ts",
      "import": "./src/model-option.ts"
    },
    "./cost": {
      "types": "./dist/src/cost.d.ts",
      "import": "./src/cost.ts"
    },
    "./catalog/*": {
      "types": "./dist/src/catalog/*.d.ts",
      "import": "./src/catalog/*.ts"
    },
    "./embeddings/*": {
      "types": "./dist/src/embeddings/*.d.ts",
      "import": "./src/embeddings/*.ts"
    }
  },
  "files": [
    "./dist/src/**/*",
    "./src/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist .cache .turbo coverage",
    "sync:models-dev": "bun scripts/sync-models-dev.ts",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/fal": "3.0.26",
    "@ai-sdk/openai-compatible": "3.0.27",
    "@ai-sdk/provider": "4.0.7",
    "@ai-sdk/provider-utils": "5.0.25",
    "@ai-sdk/replicate": "3.0.26",
    "@browser-ai/transformers-js": "3.0.0",
    "@chonkiejs/core": "^0.0.11",
    "@fal-ai/client": "1.11.0-alpha.2",
    "@foundry/agents": "workspace:*",
    "@foundry/lib": "workspace:*",
    "@huggingface/transformers": "^4.2.0",
    "@kreuzberg/tree-sitter-language-pack": "^1.10.9",
    "ai": "7.0.58",
    "ai-sdk-provider-claude-code": "4.0.1",
    "ai-sdk-provider-codex-cli": "2.1.2",
    "evlog": "^2.25.0",
    "werift": "0.24.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@foundry/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.9",
    "happy-dom": "^20.11.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
