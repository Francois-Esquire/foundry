{
  "name": "@foundry/artifacts",
  "version": "0.1.0",
  "private": true,
  "description": "The Artifact substrate \u2014 stable identity, versioned Content, and directly usable files.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./src/node/index.ts",
      "default": "./src/node/index.ts"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing/*": {
      "types": "./dist/testing/*.d.ts",
      "import": "./src/testing/*.ts",
      "default": "./src/testing/*.ts"
    }
  },
  "files": [
    "./dist/**/*",
    "./src/**/*",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist .cache .turbo coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foundry/core": "workspace:*",
    "@foundry/lib": "workspace:*",
    "@foundry/workspaces": "workspace:*",
    "@noble/hashes": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@foundry/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
