{
  "name": "@foundry/artifacts",
  "version": "0.1.0",
  "private": true,
  "description": "The Artifact substrate \u2014 stable identity, versioned Content, and directly usable files.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./src/node/index.ts",
      "default": "./src/node/index.ts"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./src/store/index.ts",
      "default": "./src/store/index.ts"
    },
    "./store/memory": {
      "types": "./dist/store/memory.d.ts",
      "import": "./src/store/memory.ts",
      "default": "./src/store/memory.ts"
    },
    "./store/sqlite": {
      "types": "./dist/store/sqlite.d.ts",
      "import": "./src/store/sqlite.ts",
      "default": "./src/store/sqlite.ts"
    },
    "./store/tables": {
      "types": "./dist/store/tables.d.ts",
      "import": "./src/store/tables.ts",
      "default": "./src/store/tables.ts"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./testing/store": {
      "types": "./dist/testing/store.d.ts",
      "import": "./src/testing/store.ts",
      "default": "./src/testing/store.ts"
    },
    "./testing/manager": {
      "types": "./dist/testing/manager.d.ts",
      "import": "./src/testing/manager.ts",
      "default": "./src/testing/manager.ts"
    }
  },
  "files": [
    "./dist/**/*",
    "./src/**/*",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist .cache .turbo coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foundry/core": "workspace:*",
    "@foundry/lib": "workspace:*",
    "@foundry/workspaces": "workspace:*",
    "@noble/hashes": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@foundry/tsconfig": "workspace:*",
    "@libsql/client": "^0.18.0",
    "@types/bun": "1.3.14",
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-orm": "^0.45.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.4"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  }
}
