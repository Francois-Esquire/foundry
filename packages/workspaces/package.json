{
  "name": "@foundry/workspaces",
  "version": "0.1.0",
  "private": true,
  "description": "The Workspace system \u2014 one durable catalog over one authoritative source.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./git": {
      "types": "./dist/node/git.d.ts",
      "import": "./src/node/git.ts",
      "default": "./src/node/git.ts"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./src/node/index.ts",
      "default": "./src/node/index.ts"
    },
    "./node/watch": {
      "types": "./dist/node/watch.d.ts",
      "import": "./src/node/watch.ts",
      "default": "./src/node/watch.ts"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./src/store/index.ts",
      "default": "./src/store/index.ts"
    },
    "./store/memory": {
      "types": "./dist/store/memory.d.ts",
      "import": "./src/store/memory.ts",
      "default": "./src/store/memory.ts"
    },
    "./testing": {
      "types": "./dist/testing/store.d.ts",
      "import": "./src/testing/store.ts",
      "default": "./src/testing/store.ts"
    }
  },
  "files": [
    "./dist/**/*",
    "./src/**/*",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist .cache .turbo coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foundry/core": "workspace:*",
    "@foundry/lib": "workspace:*",
    "ignore": "^7.0.6",
    "simple-git": "^3.36.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@foundry/tsconfig": "workspace:*",
    "@parcel/watcher": "^2.5.1",
    "@types/bun": "1.3.14",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@parcel/watcher": "^2.5.1"
  },
  "peerDependenciesMeta": {
    "@parcel/watcher": {
      "optional": true
    }
  }
}
