{
  "name": "@foundry/workflows",
  "version": "0.1.0",
  "private": true,
  "description": "Workflow kernel: Step and Workflow, run on @foundry/queue through a queue handler. Effect-backed inside, plain TS at the seam.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./approval": {
      "types": "./dist/approval.d.ts",
      "import": "./src/approval.ts"
    },
    "./authored": {
      "types": "./dist/authored.d.ts",
      "import": "./src/authored.ts"
    },
    "./channels": {
      "types": "./dist/channels-public.d.ts",
      "import": "./src/channels-public.ts"
    },
    "./definitions": {
      "types": "./dist/definitions.d.ts",
      "import": "./src/definitions.ts"
    },
    "./executable": {
      "types": "./dist/executable-public.d.ts",
      "import": "./src/executable-public.ts"
    },
    "./queue-handler": {
      "types": "./dist/queue-handler.d.ts",
      "import": "./src/queue-handler.ts"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./src/schema.ts"
    },
    "./snapshot": {
      "types": "./dist/snapshot-public.d.ts",
      "import": "./src/snapshot-public.ts"
    },
    "./step": {
      "types": "./dist/step.d.ts",
      "import": "./src/step.ts"
    },
    "./step-hooks": {
      "types": "./dist/step-hooks.d.ts",
      "import": "./src/step-hooks.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.ts"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "import": "./src/workflow.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist .cache .turbo coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foundry/lib": "workspace:*",
    "@foundry/queue": "workspace:*",
    "effect": "^3.22.1",
    "evlog": "^2.25.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@foundry/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
