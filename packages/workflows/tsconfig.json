{
  "extends": "@foundry/tsconfig/compiled-package.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ],
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "stripInternal": true,
    "sourceMap": true,
    "types": ["bun"]
  },
  "include": ["src/**/*", "../*.ts"],
  "exclude": ["node_modules", "dist"]
}
