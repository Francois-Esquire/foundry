{
  "name": "@foundry/agents",
  "version": "0.1.0",
  "private": true,
  "description": "Agent harness, sessions, authorization, skills, and MCP for Foundry agents",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./src/node/index.ts",
      "default": "./src/node/index.ts"
    },
    "./harness": {
      "types": "./dist/harness/index.d.ts",
      "import": "./src/harness/index.ts",
      "default": "./src/harness/index.ts"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "import": "./src/session/index.ts",
      "default": "./src/session/index.ts"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./src/store/index.ts",
      "default": "./src/store/index.ts"
    },
    "./store/memory": {
      "types": "./dist/store/memory.d.ts",
      "import": "./src/store/memory.ts",
      "default": "./src/store/memory.ts"
    },
    "./store/sqlite": {
      "types": "./dist/store/sqlite.d.ts",
      "import": "./src/store/sqlite.ts",
      "default": "./src/store/sqlite.ts"
    },
    "./store/tables": {
      "types": "./dist/store/tables.d.ts",
      "import": "./src/store/tables.ts",
      "default": "./src/store/tables.ts"
    },
    "./authorization": {
      "types": "./dist/authorization/index.d.ts",
      "import": "./src/authorization/index.ts",
      "default": "./src/authorization/index.ts"
    },
    "./skills": {
      "types": "./dist/skills/index.d.ts",
      "import": "./src/skills/index.ts",
      "default": "./src/skills/index.ts"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./src/mcp/index.ts",
      "default": "./src/mcp/index.ts"
    },
    "./testing/store": {
      "types": "./dist/testing/store.d.ts",
      "import": "./src/testing/store.ts",
      "default": "./src/testing/store.ts"
    }
  },
  "files": [
    "./dist/**/*",
    "./src/**/*",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .cache .turbo coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.102",
    "@foundry/authorization": "workspace:*",
    "@foundry/core": "workspace:*",
    "@foundry/lib": "workspace:*",
    "ai": "7.0.179",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.39",
    "@foundry/tsconfig": "workspace:*",
    "@libsql/client": "^0.18.0",
    "@types/bun": "1.4.5",
    "@vitest/coverage-v8": "^5.1.1",
    "drizzle-orm": "^0.45.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.4"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  }
}
