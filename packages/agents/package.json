{
  "name": "@foundry/agents",
  "version": "0.1.0",
  "private": true,
  "description": "Provider configuration and model registry for Foundry agents",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./agents/*": {
      "types": "./src/agents/*.ts",
      "import": "./src/agents/*.ts"
    },
    "./tools/*": {
      "types": "./src/tools/*.ts",
      "import": "./src/tools/*.ts"
    },
    "./harness": {
      "types": "./src/harness/index.ts",
      "import": "./src/harness/index.ts"
    },
    "./mcp": {
      "types": "./src/mcp/index.ts",
      "import": "./src/mcp/index.ts"
    },
    "./session": {
      "types": "./src/session/index.ts",
      "import": "./src/session/index.ts"
    },
    "./memory": {
      "types": "./src/memory/index.ts",
      "import": "./src/memory/index.ts"
    },
    "./contexts": {
      "types": "./src/contexts/index.ts",
      "import": "./src/contexts/index.ts"
    },
    "./authorization": {
      "types": "./src/authorization/index.ts",
      "import": "./src/authorization/index.ts"
    },
    "./transport": {
      "types": "./src/transport/index.ts",
      "import": "./src/transport/index.ts"
    },
    "./skills": {
      "types": "./src/skills/index.ts",
      "import": "./src/skills/index.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist .cache .turbo coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.29",
    "@ai-sdk/provider": "4.0.7",
    "@foundry/lib": "workspace:*",
    "ai": "7.0.58",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@foundry/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
