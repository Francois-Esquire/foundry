{
  "name": "@foundry/sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "Portable sandbox filesystem, command, and optional capability facets",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./src/node/index.ts",
      "default": "./src/node/index.ts"
    },
    "./providers/microsandbox": {
      "types": "./dist/providers/microsandbox.d.ts",
      "import": "./src/providers/microsandbox.ts",
      "default": "./src/providers/microsandbox.ts"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./src/store/index.ts",
      "default": "./src/store/index.ts"
    },
    "./store/memory": {
      "types": "./dist/store/memory.d.ts",
      "import": "./src/store/memory.ts",
      "default": "./src/store/memory.ts"
    },
    "./store/sqlite": {
      "types": "./dist/store/sqlite.d.ts",
      "import": "./src/store/sqlite.ts",
      "default": "./src/store/sqlite.ts"
    },
    "./store/tables": {
      "types": "./dist/store/tables.d.ts",
      "import": "./src/store/tables.ts",
      "default": "./src/store/tables.ts"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./testing/store": {
      "types": "./dist/testing/store.d.ts",
      "import": "./src/testing/store.ts",
      "default": "./src/testing/store.ts"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./src/tools/index.ts",
      "default": "./src/tools/index.ts"
    },
    "./virtual": {
      "types": "./dist/virtual/index.d.ts",
      "import": "./src/virtual/index.ts",
      "default": "./src/virtual/index.ts"
    }
  },
  "files": [
    "./dist/**/*",
    "./src/**/*",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .cache .turbo coverage",
    "setup:integration": "bun src/test/helpers/setup-runtime.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foundry/core": "workspace:*",
    "@foundry/lib": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@foundry/tsconfig": "workspace:*",
    "@libsql/client": "^0.18.0",
    "@types/bun": "1.4.5",
    "@types/node": "^26.6.6",
    "drizzle-orm": "^0.45.4",
    "just-bash": "^3.6.1",
    "microsandbox": "0.7.16",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.4",
    "just-bash": "^3.6.1",
    "microsandbox": "0.7.16"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "just-bash": {
      "optional": true
    },
    "microsandbox": {
      "optional": true
    }
  }
}
