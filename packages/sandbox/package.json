{
  "name": "@foundry/sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "Portable sandbox filesystem, command, and optional capability facets",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "./dist/**/*",
    "./src/**/*",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist .cache .turbo coverage",
    "setup:integration": "bun src/test/helpers/setup-runtime.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foundry/core": "workspace:*",
    "@foundry/lib": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@foundry/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "^26.4.1",
    "just-bash": "^3.2.0",
    "microsandbox": "0.6.18",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "just-bash": "^3.2.0",
    "microsandbox": "0.6.18"
  },
  "peerDependenciesMeta": {
    "just-bash": {
      "optional": true
    },
    "microsandbox": {
      "optional": true
    }
  }
}
