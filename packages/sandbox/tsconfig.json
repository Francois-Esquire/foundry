{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@foundry/tsconfig/compiled-package.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": ["ES2022", "DOM", "ESNext.Disposable"],
    "types": ["bun", "node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
