{
  "name": "@foundry/sheets",
  "version": "0.1.0",
  "private": true,
  "description": "Sheets Module: workbooks of formulas calculated by HyperFormula.",
  "license": "MIT AND GPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./workbook/*": {
      "types": "./src/workbook/*.ts",
      "import": "./src/workbook/*.ts",
      "default": "./src/workbook/*.ts"
    },
    "./editor/*": {
      "types": "./src/editor/*.ts",
      "import": "./src/editor/*.ts",
      "default": "./src/editor/*.ts"
    },
    "./composition": {
      "types": "./src/composition.ts",
      "import": "./src/composition.ts",
      "default": "./src/composition.ts"
    }
  },
  "scripts": {
    "build": "bun src/build.ts",
    "clean": "rm -rf dist .cache .turbo coverage",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hyperformula": "3.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@foundry/artifacts": "workspace:*",
    "@foundry/modules": "workspace:*",
    "@foundry/tsconfig": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.7",
    "happy-dom": "^20.11.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
