# Foundry application environment.
# ---

# API key for the Vercel AI Gateway.
# @required @sensitive @type=string
AI_GATEWAY_API_KEY=

# Optional long-lived Claude subscription token; otherwise use the host login.
# @optional @sensitive @type=string
CLAUDE_CODE_OAUTH_TOKEN=

# Exact Codex model id the task pipeline routes with (see
# apps/marbles/examples/task-pipeline.md). Unset leaves routing blocked.
# @optional @type=string
MARBLES_PIPELINE_ROUTER_MODEL=
