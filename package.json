{
  "name": "foundry",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "examples/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "bun run typecheck",
    "clean": "turbo run clean && bun run clean:root",
    "clean:root": "rm -rf .turbo .cache",
    "dead-code": "knip",
    "dev": "turbo run dev",
    "dev:marbles": "turbo run dev -F @foundry.sh/marbles --",
    "dev:spyglass": "turbo run dev -F @foundry.sh/spyglass --log-order=stream --",
    "dev:spyglass:package": "turbo run dev:package -F @foundry.sh/spyglass --log-order=stream --",
    "docs:build": "turbo run docs:build --filter=@foundry/docs",
    "docs:check": "turbo run docs:check --filter=@foundry/docs",
    "docs:dev": "turbo run docs:dev --filter=@foundry/docs",
    "docs:typecheck": "turbo run typecheck --filter=@foundry/docs",
    "env:check": "varlock load --agent",
    "env:run": "varlock run --",
    "fix": "ultracite fix",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:deps": "sherif",
    "lint:deps-fix": "sherif --fix",
    "lint:fix": "biome lint --write .",
    "marbles": "bun run --no-env-file apps/marbles/dist/cli.js",
    "prepare": "husky",
    "release:check": "bun run tooling/release/src/cli.ts check",
    "release:pack": "bun run tooling/release/src/cli.ts pack",
    "release:prepare": "bun run tooling/release/src/prepare.ts",
    "release:resolve": "bun run tooling/release/src/cli.ts resolve",
    "spyglass": "bun run apps/spyglass/dist/lib/spyglass.js",
    "test": "turbo run test",
    "test:boundaries": "vitest run",
    "test:coverage": "turbo run test:coverage",
    "test:package": "turbo run test:package",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "validate": "bun run check && bun run lint:deps && bun run typecheck && bun run dead-code && bun run test:boundaries"
  },
  "overrides": {
    "ai-sdk-provider-claude-code@4.4.1": {
      "@anthropic-ai/claude-agent-sdk": "0.3.330"
    },
    "textbook-sh@0.2.0": {
      "@opentui/core": "0.9.7"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@foundry/tsconfig": "workspace:*",
    "@types/node": "^26.6.6",
    "husky": "9.1.7",
    "knip": "6.47.0",
    "sherif": "1.13.0",
    "turbo": "^2.11.13",
    "typescript": "^6.0.3",
    "ultracite": "7.11.0",
    "varlock": "1.25.0",
    "vitest": "^5.1.1"
  },
  "packageManager": "bun@1.4.5",
  "packageExtensions": {
    "@opentui/react@0.9.7": {
      "peerDependenciesMeta": {
        "react-devtools-core": {
          "optional": true
        },
        "ws": {
          "optional": true
        }
      }
    },
    "bun-ffi-structs@0.3.1": {
      "peerDependenciesMeta": {
        "typescript": {
          "optional": true
        }
      }
    }
  },
  "patchedDependencies": {
    "vitest@5.1.1": "patches/vitest@5.1.1.patch"
  }
}
