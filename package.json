{
  "name": "foundry",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "dev:tui": "turbo run dev -F tui --",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@foundry/tsconfig": "workspace:*",
    "@types/node": "^26.4.1",
    "husky": "latest",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "ultracite": "7.11.0",
    "varlock": "1.18.0"
  },
  "packageManager": "bun@1.3.14"
}
