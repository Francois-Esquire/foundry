{
  "name": "foundry",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "changelog": "bun run tooling/release/src/cli.ts changelog",
    "check": "ultracite check",
    "check-types": "bun run typecheck",
    "clean": "turbo run clean && bun run clean:root",
    "clean:root": "rm -rf .turbo .cache .blume dist",
    "dead-code": "knip",
    "dev": "turbo run dev",
    "dev:quirks": "turbo run dev -F @foundry/quirks --",
    "docs:build": "blume build",
    "docs:check": "blume validate --strict",
    "docs:dev": "blume dev",
    "docs:typecheck": "tsc --project tsconfig.docs.json",
    "fix": "ultracite fix",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:deps": "sherif",
    "lint:deps-fix": "sherif --fix",
    "lint:fix": "biome lint --write .",
    "prepare": "husky",
    "quirks": "bun run apps/quirks/dist/cli.js",
    "release:check": "bun run tooling/release/src/cli.ts check",
    "release:pack": "bun run tooling/release/src/cli.ts pack",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:package": "turbo run test:package",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "validate": "bun run check && bun run lint:deps && bun run typecheck && bun run dead-code"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@foundry/tsconfig": "workspace:*",
    "@types/node": "^26.4.1",
    "blume": "1.6.3",
    "husky": "latest",
    "knip": "6.32.0",
    "sherif": "1.13.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "ultracite": "7.11.0",
    "varlock": "1.18.0"
  },
  "packageManager": "bun@1.3.14"
}
