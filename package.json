{
  "name": "foundry",
  "version": "0.0.1",
  "description": "A CLI for the Foundry project",
  "bin": {
    "foundry": "./bin/index.cjs"
  },
  "main": "dist/index.js",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "build": "bun build:lib && bun build:cli && bun build:a2a && bun build:mcp",
    "build:mcp": "bun build ./src/consumers/mcp/index.ts --outfile ./dist/mcp.js --target bun",
    "build:a2a": "bun build ./src/consumers/a2a/index.ts --outfile ./dist/a2a.js --target bun",
    "build:cli": "bun build ./src/consumers/cli/index.ts --outfile ./dist/cli.js --target bun",
    "build:lib": "bun build ./src/index.ts --outfile ./dist/index.js --target bun",
    "format": "prettier --check . --ignore-path .gitignore",
    "format:fix": "prettier --write . --ignore-path .gitignore",
    "test": "bun test tests/**/*.test.ts",
    "test:watch": "bun test --watch tests/**/*.test.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.10",
    "@ai-sdk/openai": "^1.3.20",
    "@streamparser/json": "^0.0.22",
    "@tensorflow-models/universal-sentence-encoder": "^1.3.3",
    "@tensorflow/tfjs-node": "^4.22.0",
    "ai": "^4.3.10",
    "dotenv": "^16.5.0",
    "fastmcp": "^1.22.4",
    "termost": "^1.4.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@types/bun": "latest",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}