{
  "extends": "@foundry/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["bun"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react"
  },
  "include": [
    "scripts/**/*",
    "src/**/*",
    "stories/**/*",
    "test/**/*",
    "vitest.config.ts"
  ]
}
