{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/spyglass": {
      "entry": [
        "scripts/*.ts",
        "src/lib/index.ts",
        "src/lib/semantics-worker.ts",
        "src/lib/config-worker.ts",
        "vitest.package.config.ts",
        "src/lib/browser-analysis.ts",
        "vitest.browser.config.ts",
        "test/browser/**/*.test.ts"
      ],
      "ignore": ["test/lib/fixtures/**"],
      "ignoreDependencies": ["@vgpu/wgsl-std"]
    },
    "apps/website": {
      "ignore": ["src/components/ascii-*.{ts,tsx}"],
      "ignoreDependencies": [
        "@foundry.sh/spyglass",
        "@react-three/fiber",
        "@react-three/postprocessing",
        "@types/three",
        "postprocessing",
        "three"
      ]
    },
    "apps/marbles": {
      "ignoreDependencies": [
        "@ai-sdk/mcp",
        "@ai-sdk/openai-compatible",
        "@ai-sdk/provider-utils",
        "@anthropic-ai/sdk",
        "@fal-ai/client",
        "@foundry/core",
        "@noble/hashes",
        "ai-sdk-provider-codex-cli",
        "ai-sdk-provider-claude-code",
        "ai-sdk-provider-pi",
        "evlog",
        "ignore",
        "simple-git"
      ],
      "entry": [
        "examples/**/*.ts",
        "templates/**/*.ts",
        "test/helpers/dry-mcp-host.ts",
        "vitest.package.config.ts"
      ]
    },
    "apps/works": {
      "entry": ["electron-builder.config.mjs", "test/electron/*.smoke.ts"],
      "ignore": ["src/app/**/*.css"],
      "ignoreDependencies": ["tailwindcss", "tw-animate-css"]
    },
    "apps/documentation": {
      "entry": [
        "blume.config.ts",
        "**/meta.ts",
        "components.ts",
        "components/**/*.astro",
        "components/annotations/mount.ts"
      ],
      "ignore": ["marbles/**/_example/**"]
    },
    "packages/models": {
      "entry": ["src/local/remote/worker-entry.ts"]
    },
    "tooling/*": {},
    "tooling/vscode-extension": {
      "ignore": ["fixtures/**"]
    },
    ".": {
      "entry": [
        ".foundry/marbles/**/*.ts",
        "!.foundry/marbles/**/_*",
        "!.foundry/marbles/**/_*/**"
      ]
    }
  }
}
