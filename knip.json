{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/spyglass": {
      "entry": [
        "scripts/*.ts",
        "src/lib/index.ts",
        "src/lib/semantics-worker.ts",
        "src/lib/config-worker.ts"
      ],
      "ignore": ["test/lib/fixtures/**"]
    },
    "apps/foundry.sh": {
      "ignore": ["src/components/ascii-*.{ts,tsx}"],
      "ignoreDependencies": [
        "@react-three/fiber",
        "@react-three/postprocessing",
        "@types/three",
        "postprocessing",
        "three"
      ]
    },
    "apps/marbles": {
      "ignoreDependencies": [
        "@ai-sdk/openai-compatible",
        "@ai-sdk/provider-utils",
        "@browser-ai/transformers-js",
        "@fal-ai/client",
        "@foundry/core",
        "@noble/hashes",
        "ai-sdk-provider-codex-cli",
        "ai-sdk-provider-claude-code",
        "evlog",
        "ignore",
        "simple-git"
      ],
      "entry": ["examples/**/*.ts", "templates/**/*.ts"]
    },
    "modules/*": {
      "entry": ["src/program.ts", "src/view.ts", "src/workflows.ts"]
    },
    "apps/works": {
      "entry": ["electron-builder.config.mjs", "test/electron/*.smoke.ts"],
      "ignore": ["src/app/**/*.css"],
      "ignoreDependencies": ["tailwindcss", "tw-animate-css"]
    },
    "docs": {
      "entry": ["blume.config.ts", "**/meta.ts"],
      "ignore": ["marbles/use-cases/**/_example/**"]
    },
    "packages/models": {
      "entry": ["src/local/remote/worker-entry.ts"]
    },
    "tooling/*": {},
    ".": {
      "entry": [
        ".foundry/marbles/**/*.ts",
        "!.foundry/marbles/**/_*",
        "!.foundry/marbles/**/_*/**"
      ]
    }
  }
}
