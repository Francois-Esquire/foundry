{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/atlas": {
      "entry": ["scripts/*.ts", "src/lib/semantics-worker.ts"],
      "ignore": ["test/lib/fixtures/**"]
    },
    "apps/marbles": {
      "ignoreDependencies": [
        "@ai-sdk/openai-compatible",
        "@ai-sdk/provider",
        "@ai-sdk/provider-utils",
        "@browser-ai/transformers-js",
        "@foundry/core",
        "@noble/hashes",
        "ai-sdk-provider-claude-code",
        "ai-sdk-provider-codex-cli",
        "evlog",
        "ignore",
        "simple-git",
        "unique-names-generator"
      ],
      "entry": ["examples/**/*.ts", "templates/**/*.ts"]
    },
    "docs": {
      "entry": ["blume.config.ts", "**/meta.ts"]
    },
    "packages/models": {
      "entry": ["src/local/remote/worker-entry.ts"]
    },
    "tooling/*": {},
    ".": {
      "entry": [
        ".foundry/marbles/**/*.ts",
        "!.foundry/marbles/**/_*",
        "!.foundry/marbles/**/_*/**"
      ]
    }
  }
}
