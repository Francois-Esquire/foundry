{
  "name": "@foundry/quirks",
  "version": "0.1.0",
  "private": false,
  "description": "Composable local automation, with agents where judgment is useful",
  "homepage": "https://github.com/Francois-Esquire/foundry/tree/main/apps/quirks#readme",
  "bugs": {
    "url": "https://github.com/Francois-Esquire/foundry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Francois-Esquire/foundry.git",
    "directory": "apps/quirks"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "quirks": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist .cache .turbo coverage",
    "dev": "bun run --watch src/cli.ts",
    "prepack": "bun run build",
    "start": "bun run src/cli.ts",
    "test": "bun run test:unit && bun run test:tui",
    "test:package": "bun test test/package.test.ts",
    "test:tui": "bun test test/status-view.test.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/provider": "4.0.7",
    "@opentui/core": "^0.5.11",
    "@parcel/watcher": "^2.5.1",
    "ai": "7.0.58",
    "ai-sdk-provider-claude-code": "4.0.1",
    "ai-sdk-provider-codex-cli": "2.1.2",
    "croner": "^9.1.0",
    "effect": "^3.22.1",
    "evlog": "^2.25.0",
    "ignore": "^7.0.6",
    "simple-git": "^3.36.0",
    "unique-names-generator": "^4.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@foundry/agents": "workspace:*",
    "@foundry/lib": "workspace:*",
    "@foundry/models": "workspace:*",
    "@foundry/tsconfig": "workspace:*",
    "@foundry/workflows": "workspace:*",
    "@foundry/workspaces": "workspace:*",
    "@types/bun": "1.3.14",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@browser-ai/transformers-js": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@browser-ai/transformers-js": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
