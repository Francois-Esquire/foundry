{
  "name": "@foundry/typography",
  "version": "0.1.0",
  "private": true,
  "description": "Creative typography studio",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun scripts/fetch-engine.ts && vite build",
    "clean": "rm -rf dist .cache .turbo coverage public/engine",
