{
  "name": "@foundry/atlas",
  "version": "0.1.0",
  "private": true,
  "description": "A CLI and local web viewer for workspace semantic surveys",
  "type": "module",
  "bin": {
    "atlas": "./dist/cli/atlas.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "clean": "rm -rf dist .cache .turbo coverage",
    "dev": "bun scripts/dev.ts",
    "start": "bun src/cli/index.ts",
    "test": "bun test test",
    "test:watch": "bun test --watch test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@foundry/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "^6.0.3",
    "vite": "8.2.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
