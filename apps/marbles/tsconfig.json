{
  "extends": "@foundry/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["bun"],
    "paths": {
      "~/*": ["./src/*"],
      "@foundry.sh/marbles": ["./src/authoring/index.ts"],
      "@foundry.sh/marbles/engine": ["./src/entries/embedded.ts"],
      "@foundry.sh/marbles/lib": ["./src/entries/lib.ts"],
      "@foundry.sh/marbles/process": ["./src/process/index.ts"],
      "@foundry.sh/marbles/providers": ["./src/authoring/providers.ts"],
      "@foundry.sh/marbles/providers/claude-code": [
        "./src/providers/claude-code.ts"
      ],
      "@foundry.sh/marbles/providers/codex": ["./src/providers/codex.ts"],
      "@foundry.sh/marbles/providers/gateway": ["./src/providers/gateway.ts"],
      "@foundry.sh/marbles/providers/pi": ["./src/providers/pi.ts"],
      "@foundry.sh/marbles/providers/vercel": ["./src/providers/vercel.ts"],
      "@foundry.sh/marbles/statuses": ["./src/lib/executions/statuses.ts"],
      "@foundry.sh/marbles/workspace": ["./src/workspace/index.ts"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react"
  },
  "include": ["src/**/*", "test/**/*", "stories/**/*", "templates/**/*"],
  "exclude": ["node_modules", "dist"]
}
