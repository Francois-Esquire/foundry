{
  "extends": ["//"],
  "tasks": {
    "db:generate": {
      "dependsOn": ["^build"],
      "outputs": ["src/database/migrations/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".cache/tsbuildinfo.json"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "env": ["MARBLES_TEST_RUNS"]
    },
    "test:integration": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "env": [
        "ANTHROPIC_API_KEY",
        "CLAUDE_CODE_OAUTH_TOKEN",
        "OPENAI_API_KEY",
        "AI_GATEWAY_API_KEY",
        "OPENROUTER_API_KEY"
      ]
    }
  }
}
