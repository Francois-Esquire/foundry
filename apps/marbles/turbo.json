{
  "extends": ["//"],
  "tasks": {
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "ANTHROPIC_API_KEY",
        "CLAUDE_CODE_OAUTH_TOKEN",
        "OPENAI_API_KEY",
        "AI_GATEWAY_API_KEY",
        "OPENROUTER_API_KEY"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/documentation/marbles/**/_example/**"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/documentation/marbles/**/_example/**"
      ]
    },
    "test:coverage": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/documentation/marbles/**/_example/**"
      ]
    }
  }
}
