{
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [
        "dist/**",
        ".cache/tsbuildinfo.json",
        "src/database/migrations/**"
      ]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "env": ["MARBLES_TEST_RUNS", "MARBLES_DAEMON_BIN"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "ANTHROPIC_API_KEY",
        "CLAUDE_CODE_OAUTH_TOKEN",
        "OPENAI_API_KEY",
        "AI_GATEWAY_API_KEY",
        "OPENROUTER_API_KEY"
      ]
    }
  }
}
