{
  "name": "@foundry.sh/marbles",
  "version": "0.0.3",
  "private": false,
  "description": "Composable local automation, with agents where judgment is useful",
  "homepage": "https://github.com/Francois-Esquire/foundry/tree/main/apps/marbles#readme",
  "bugs": {
    "url": "https://github.com/Francois-Esquire/foundry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Francois-Esquire/foundry.git",
    "directory": "apps/marbles"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./prebuilt": {
      "types": "./dist/prebuilt.d.ts",
      "default": "./dist/prebuilt.js"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "default": "./dist/process.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "default": "./dist/workspace.js"
    }
  },
  "bin": {
    "marbles": "./bin/marbles"
  },
  "files": [
    "bin/marbles",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsup",
    "clean": "rm -rf dist .cache .turbo coverage",
    "dev": "bun run --no-env-file --watch src/cli.ts",
    "mcp": "bun run --no-env-file src/mcp/stdio.ts",
    "prepack": "bun run build",
    "preview:ui": "bun run --no-env-file preview/dashboard.tsx",
    "start": "bun run --no-env-file src/cli.ts",
    "test": "bun ../../node_modules/vitest/vitest.mjs run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:package": "bun ../../node_modules/vitest/vitest.mjs run --config vitest.package.config.ts",
    "test:watch": "bun ../../node_modules/vitest/vitest.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.29",
    "@ai-sdk/openai-compatible": "3.0.27",
    "@ai-sdk/provider": "4.0.7",
    "@ai-sdk/provider-utils": "5.0.25",
    "@anthropic-ai/claude-agent-sdk": "0.3.205",
    "@anthropic-ai/sdk": "0.124.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@noble/hashes": "^2.2.0",
    "@opentui/core": "0.5.11",
    "@opentui/react": "0.5.11",
    "@parcel/watcher": "^2.5.1",
    "@standard-schema/spec": "1.1.0",
    "ai": "7.0.58",
    "ai-sdk-provider-claude-code": "4.0.1",
    "ai-sdk-provider-codex-cli": "2.1.2",
    "ai-sdk-provider-pi": "0.1.0",
    "croner": "^9.1.0",
    "effect": "^3.22.1",
    "evlog": "^2.25.0",
    "ignore": "^7.0.6",
    "react": "19.3.0",
    "simple-git": "^3.36.0",
    "unique-names-generator": "^4.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@foundry/agents": "workspace:*",
    "@foundry/artifacts": "workspace:*",
    "@foundry/core": "workspace:*",
    "@foundry/lib": "workspace:*",
    "@foundry/models": "workspace:*",
    "@foundry/sandbox": "workspace:*",
    "@foundry/tasks": "workspace:*",
    "@foundry/tsconfig": "workspace:*",
    "@foundry/usage": "workspace:*",
    "@foundry/workflows": "workspace:*",
    "@foundry/workspaces": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/react": "19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@fal-ai/client": "1.11.0-alpha.2",
    "microsandbox": "0.6.18",
    "typescript": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@fal-ai/client": {
      "optional": true
    },
    "microsandbox": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
