{
  "name": "@foundry.sh/marbles",
  "version": "0.0.4",
  "private": false,
  "description": "Composable local automation, with agents where judgment is useful",
  "homepage": "https://github.com/Francois-Esquire/foundry/tree/main/apps/marbles#readme",
  "bugs": {
    "url": "https://github.com/Francois-Esquire/foundry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Francois-Esquire/foundry.git",
    "directory": "apps/marbles"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./lib": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./statuses": {
      "types": "./dist/statuses.d.ts",
      "default": "./dist/statuses.js"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "default": "./dist/process.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "default": "./dist/providers.js"
    },
    "./providers/claude-code": {
      "types": "./dist/providers/claude-code.d.ts",
      "default": "./dist/providers/claude-code.js"
    },
    "./providers/codex": {
      "types": "./dist/providers/codex.d.ts",
      "default": "./dist/providers/codex.js"
    },
    "./providers/gateway": {
      "types": "./dist/providers/gateway.d.ts",
      "default": "./dist/providers/gateway.js"
    },
    "./providers/pi": {
      "types": "./dist/providers/pi.d.ts",
      "default": "./dist/providers/pi.js"
    },
    "./providers/vercel": {
      "types": "./dist/providers/vercel.d.ts",
      "default": "./dist/providers/vercel.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "default": "./dist/workspace.js"
    }
  },
  "bin": {
    "marbles": "./bin/marbles"
  },
  "files": [
    "bin/marbles",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/migrations/**",
    "CHANGELOG.md",
    "LICENSE.vendors"
  ],
  "scripts": {
    "build": "rm -rf dist && bun run db:generate && NODE_OPTIONS=--max-old-space-size=8192 tsup",
    "clean": "rm -rf dist .cache .turbo coverage src/database/migrations",
    "db:generate": "bun drizzle.generate.ts",
    "dev": "bun run --no-env-file --watch src/cli.ts",
    "mcp": "bun run --no-env-file src/cli.ts mcp",
    "prepack": "bun run build",
    "start": "bun run --no-env-file src/cli.ts",
    "stories": "bun run --no-env-file textbook --pattern 'stories/**/*.stories.tsx'",
    "stories:web": "cd ../.. && bun run --no-env-file textbook web --cwd apps/marbles --pattern 'stories/**/*.stories.tsx'",
    "test": "bun ../../node_modules/vitest/vitest.mjs run",
    "test:integration": "bun ../../node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:package": "bun ../../node_modules/vitest/vitest.mjs run --config vitest.package.config.ts",
    "test:watch": "bun ../../node_modules/vitest/vitest.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.102",
    "@ai-sdk/openai-compatible": "3.0.94",
    "@ai-sdk/provider": "4.0.39",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/hashes": "^2.4.0",
    "@opentui/core": "0.5.11",
    "@opentui/react": "0.5.11",
    "@standard-schema/spec": "1.1.0",
    "@types/node": "^26.6.6",
    "ai": "7.0.178",
    "croner": "^11.0.1",
    "drizzle-orm": "^0.45.4",
    "effect": "^3.22.5",
    "evlog": "^2.36.0",
    "ignore": "^7.0.16",
    "react": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@anthropic-ai/sdk": "1.12.0",
    "@foundry/agents": "workspace:*",
    "@foundry/artifacts": "workspace:*",
    "@foundry/authorization": "workspace:*",
    "@foundry/core": "workspace:*",
    "@foundry/lib": "workspace:*",
    "@foundry/models": "workspace:*",
    "@foundry/prompts": "workspace:*",
    "@foundry/queue": "workspace:*",
    "@foundry/sandbox": "workspace:*",
    "@foundry/scheduling": "workspace:*",
    "@foundry/tasks": "workspace:*",
    "@foundry/tsconfig": "workspace:*",
    "@foundry/usage": "workspace:*",
    "@foundry/workflows": "workspace:*",
    "@foundry/workspaces": "workspace:*",
    "@types/bun": "1.4.5",
    "@types/react": "19.3.0",
    "@xterm/headless": "6.0.0",
    "ai-sdk-provider-claude-code": "4.4.1",
    "ai-sdk-provider-codex-cli": "2.4.0",
    "ai-sdk-provider-pi": "0.1.0",
    "drizzle-kit": "^0.31.11",
    "textbook-sh": "0.2.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@anthropic-ai/sdk": "1.12.0",
    "ai-sdk-provider-claude-code": "4.4.1",
    "ai-sdk-provider-codex-cli": "2.4.0",
    "ai-sdk-provider-pi": "0.1.0",
    "microsandbox": "0.6.18"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "ai-sdk-provider-claude-code": {
      "optional": true
    },
    "ai-sdk-provider-codex-cli": {
      "optional": true
    },
    "ai-sdk-provider-pi": {
      "optional": true
    },
    "microsandbox": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
