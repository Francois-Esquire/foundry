---
import Arrow from "../components/arrow.astro";
import ExplodedStack from "../components/exploded-stack.astro";
import { linesHtml, notes } from "../examples/marbles-walkthrough";
import SiteLayout from "../layouts/site-layout.astro";
import { site } from "../site";

const libraries = [
  {
    description: "Steps, workflows, runs, and queues.",
    path: "workflows",
    usedBy: "Marbles",
  },
  {
    description: "Agent sessions, tools, and authorization.",
    path: "agents",
    usedBy: "Marbles",
  },
  {
    description: "One registry for providers, CLI harnesses, and local models.",
    path: "models",
    usedBy: "Marbles",
  },
  {
    description: "A durable catalog over your files.",
    path: "workspaces",
    usedBy: "Marbles",
  },
  {
    description: "Versioned outputs with a stable identity.",
    path: "artifacts",
    usedBy: "Marbles, Works",
  },
  {
    description: "A portable filesystem and command runner.",
    path: "sandbox",
    usedBy: "Marbles, Works",
  },
];
---

<SiteLayout title="Foundry — Tools that come apart. On purpose.">
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="section-label hero-label">Local · Open source · MIT</p>
      <h1 id="hero-title">Tools that come apart.<br /> On&nbsp;purpose.</h1>
      <p class="hero-description">Foundry builds local, open-source tools for working with agents, creating things, and understanding code.</p>
      <a class="button" href="#tools">Explore the tools <Arrow /></a>
    </div>
    <figure class="hero-figure"><ExplodedStack /></figure>
  </section>

  <section class="tools-section" id="tools" aria-labelledby="tools-title">
    <div class="wrap">
      <h2 class="visually-hidden" id="tools-title">Tools</h2>
      <div class="product-sections">
        <article class="product-section" id="marbles" aria-labelledby="marbles-name marbles-title">
          <div class="product-head">
            <div>
              <p class="product-name" id="marbles-name">Marbles</p>
              <h3 id="marbles-title">Agentic infrastructure, unpacked.</h3>
            </div>
            <div class="product-head-copy">
              <p>Write workflows in TypeScript, give agents a workspace, and decide what happens next. This is a whole workflow file.</p>
              <a class="text-link" href={`${site.docs}marbles/`}>Make a workflow <Arrow /></a>
            </div>
          </div>
          <div class="code-walkthrough">
            <figure class="code-example">
              <figcaption><code class="file-name">.foundry/marbles/assess.ts</code></figcaption>
              <pre><code set:html={linesHtml} /></pre>
            </figure>
            <ol class="code-notes" role="list">
              {notes.map((note, index) => <li><span class="code-mark" aria-hidden="true">{index + 1}</span><div><p class="code-note-title">{note.title}</p><p class="code-note-body" set:html={note.body} /></div></li>)}
            </ol>
          </div>
        </article>
        <article class="product-section" id="spyglass" aria-labelledby="spyglass-name spyglass-title">
          <p class="product-name" id="spyglass-name">Spyglass</p>
          <div class="product-content">
            <div class="product-copy">
              <h3 id="spyglass-title">Get the lay of your code.</h3>
              <p>Explore your codebase as a landscape of files, packages, and dependencies. See what belongs together, where dependencies circle back, and which abstractions deserve a closer look.</p>
              <a class="text-link" href={`${site.docs}spyglass/`}>Explore your codebase <Arrow /></a>
            </div>
            <div class="tool-art spyglass-art" aria-label="Illustration of a codebase map with connected packages, files, and dependencies">
              <svg viewBox="0 0 560 310" fill="none" aria-hidden="true">
                <g stroke="currentColor" stroke-width="1" opacity=".42"><path d="m98 184 129-107 118 121 124-97M98 184l136 64 111-50M227 77l242 24M234 248l235-147" stroke-dasharray="3 5" /></g>
                <g fill="currentColor"><circle cx="98" cy="184" r="8"/><circle cx="227" cy="77" r="12"/><circle cx="345" cy="198" r="17"/><circle cx="469" cy="101" r="7"/><circle cx="234" cy="248" r="6"/></g>
                <g stroke="currentColor"><circle cx="98" cy="184" r="22"/><circle cx="227" cy="77" r="29"/><circle cx="345" cy="198" r="40"/><circle cx="469" cy="101" r="19"/><circle cx="234" cy="248" r="17"/></g>
                <g fill="currentColor" opacity=".5"><circle cx="71" cy="163" r="3"/><circle cx="113" cy="218" r="3"/><circle cx="198" cy="52" r="3"/><circle cx="254" cy="40" r="3"/><circle cx="261" cy="103" r="3"/><circle cx="308" cy="158" r="3"/><circle cx="396" cy="184" r="3"/><circle cx="375" cy="241" r="3"/><circle cx="323" cy="253" r="3"/><circle cx="494" cy="78" r="3"/></g>
              </svg>
              <span class="map-label map-label-packages">packages</span><span class="map-label map-label-files">files</span><span class="specimen-caption">Find your bearings.</span>
            </div>
          </div>
        </article>
        <article class="product-section" id="works" aria-labelledby="works-name works-title">
          <p class="product-name" id="works-name">Works <span class="release-status">Coming soon</span></p>
          <div class="product-content">
            <div class="product-copy">
              <h3 id="works-title">Make something. Make the tool fit.</h3>
              <p>Create documents, images, videos, and apps with tools you can change. Each editor is a module: a small app you can customize, build yourself, or share.</p>
            </div>
            <div class="works-example">
              <p class="works-joke">Found a bug in your word processor? Fix it without applying for a job there first.</p>
              <p class="works-example-description">For example, add a citation checker to your document editor, then use it to review your next draft. The editor is the module. The document is the artifact.</p>
            </div>
          </div>
        </article>
      </div>
      <div class="parts-section">
        <div class="product-head">
          <div>
            <p class="product-name">Parts</p>
            <h3 id="parts-title">And the parts to build your own.</h3>
          </div>
          <p class="product-head-copy">Marbles and Works are assembled from these libraries. Every one lives in the same repository, and you can read it.</p>
        </div>
        <table class="parts-list" aria-labelledby="parts-title">
          <thead><tr><th scope="col">Package</th><th scope="col">What it is</th><th scope="col">Used by</th></tr></thead>
          <tbody>
            {libraries.map((library) => <tr><th scope="row"><a class="part-link" href={`${site.repository}/tree/main/packages/${library.path}`}>@foundry/{library.path}</a></th><td>{library.description}</td><td>{library.usedBy}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="vision-section wrap" id="about" aria-labelledby="about-title">
    <div class="vision-heading">
      <p class="section-label">About Foundry</p>
      <h2 id="about-title">Nothing leaves your machine unless you say so.</h2>
    </div>
    <div class="vision-copy">
      <p>Every Foundry tool runs on your machine and keeps its state on disk.</p>
      <p>The source is open and MIT licensed, and the tools are built from libraries you can read in the same repository. When a tool doesn’t fit, you can see why, and you can change it.</p>
      <a class="text-link" href={site.repository}>Read the source <Arrow /></a>
    </div>
  </section>
  <section class="closing-section" aria-labelledby="closing-title"><div class="wrap closing-content"><h2 id="closing-title">Pick a tool.<br />Take it apart.</h2><div><p>Marbles and Spyglass run from a checkout of the repository today. The docs cover both.</p><a class="button" href={site.docs}>Read the docs <Arrow /></a></div></div></section>
</SiteLayout>
