{
  "name": "@foundry.sh/spyglass",
  "version": "0.0.3",
  "private": false,
  "description": "Workspace analysis as a CLI, a library, and a local viewer",
  "homepage": "https://github.com/Francois-Esquire/foundry/tree/main/apps/spyglass#readme",
  "bugs": {
    "url": "https://github.com/Francois-Esquire/foundry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Francois-Esquire/foundry.git",
    "directory": "apps/spyglass"
  },
  "license": "MIT",
  "type": "module",
  "imports": {
    "#file-map-cruise-engine": {
      "types": "./src/lib/file-map-cruise-engine.ts",
      "spyglass-browser": "./src/lib/file-map-cruise-engine.ts",
      "default": "./dist/engine/file-map-cruise-engine.js"
    },
    "#path": {
      "spyglass-browser": "./src/lib/path-posix.ts",
      "default": "./src/lib/path-native.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    }
  },
  "bin": {
    "spyglass": "./dist/lib/spyglass.js"
  },
  "files": [
    "dist/lib",
    "dist/web",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:analysis": "bun scripts/build-analysis.ts",
    "build:test-engine": "bun scripts/build-test-engine.ts",
    "clean": "rm -rf dist .cache .turbo coverage",
    "dev": "bun scripts/dev.ts",
    "dev:package": "bun scripts/dev.ts --package",
    "prepack": "bun run build",
    "start": "bun src/cli/spyglass.ts",
    "test": "bun ../../node_modules/vitest/vitest.mjs run",
    "test:browser": "bun ../../node_modules/vitest/vitest.mjs run --config vitest.browser.config.ts",
    "test:package": "bun ../../node_modules/vitest/vitest.mjs run --config vitest.package.config.ts",
    "test:watch": "bun ../../node_modules/vitest/vitest.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@opentui/core": "0.5.11",
    "dependency-cruiser": "17.4.3",
    "ignore": "^7.0.6",
    "picocolors": "^1.1.1",
    "string-width": "^8.2.2",
    "ts-morph": "^26.0.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@foundry/lib": "workspace:*",
    "@foundry/tsconfig": "workspace:*",
    "@octokit/request": "^10.0.16",
    "@octokit/request-error": "^7.1.2",
    "@types/bun": "1.3.14",
    "@types/d3-contour": "^3.0.6",
    "@types/path-browserify": "^1.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.7",
    "@vgpu/wgsl": "0.6.0",
    "@vgpu/wgsl-std": "0.6.0",
    "@vitejs/plugin-react": "5.2.0",
    "d3-contour": "^4.0.2",
    "happy-dom": "^20.11.2",
    "memfs": "^4.80.0",
    "path-browserify": "^1.0.1",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "^8.5.1",
    "vgpu": "0.6.0",
    "vite": "8.2.2",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
