{
  "name": "@foundry.sh/spyglass",
  "version": "0.0.1",
  "private": false,
  "description": "Workspace analysis as a CLI, a library, and a local viewer",
  "homepage": "https://github.com/Francois-Esquire/foundry/tree/main/apps/spyglass#readme",
  "bugs": {
    "url": "https://github.com/Francois-Esquire/foundry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Francois-Esquire/foundry.git",
    "directory": "apps/spyglass"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    }
  },
  "bin": {
    "spyglass": "./dist/lib/spyglass.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "check:layers": "depcruise --config .dependency-cruiser.cjs src/web",
    "clean": "rm -rf dist .cache .turbo coverage",
    "dev": "bun scripts/dev.ts",
    "prepack": "bun run build",
    "start": "bun src/cli/spyglass.ts",
    "test": "bun run check:layers && vitest run && bun test test/spyglass.test.ts",
    "test:package": "bun test test/package.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dependency-cruiser": "^17.0.1",
    "ignore": "^7.0.6",
    "picocolors": "^1.1.1",
    "string-width": "^8.2.2",
    "ts-morph": "^26.0.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@foundry/lib": "workspace:*",
    "@foundry/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/d3-contour": "^3.0.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "5.2.0",
    "d3-contour": "^4.0.2",
    "happy-dom": "^20.11.2",
    "polygon-clipping": "0.15.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.185.1",
    "tsup": "^8.5.1",
    "vite": "8.2.2",
    "vitest": "^4.1.9"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
