{
  "name": "@foundry.sh/spyglass",
  "version": "0.0.4",
  "private": false,
  "description": "Workspace analysis as a CLI, a library, and a local viewer",
  "homepage": "https://github.com/Francois-Esquire/foundry/tree/main/apps/spyglass#readme",
  "bugs": {
    "url": "https://github.com/Francois-Esquire/foundry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Francois-Esquire/foundry.git",
    "directory": "apps/spyglass"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    }
  },
  "bin": {
    "spyglass": "./dist/lib/spyglass.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "clean": "rm -rf dist .cache .turbo coverage",
    "dev": "bun scripts/dev.ts",
    "dev:package": "bun scripts/dev.ts --package",
    "prepack": "bun run build",
    "start": "bun src/cli/spyglass.ts",
    "test": "bun ../../node_modules/vitest/vitest.mjs run",
    "test:package": "bun ../../node_modules/vitest/vitest.mjs run --config vitest.package.config.ts",
    "test:watch": "bun ../../node_modules/vitest/vitest.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "0.9.7",
    "dependency-cruiser": "^18.8.0",
    "ignore": "^7.0.16",
    "picocolors": "^1.1.1",
    "string-width": "^9.0.0",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@foundry/core": "workspace:*",
    "@foundry/lib": "workspace:*",
    "@foundry/tsconfig": "workspace:*",
    "@types/bun": "1.4.5",
    "@types/d3-contour": "^3.0.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vgpu/wgsl": "0.6.0",
    "@vgpu/wgsl-std": "0.6.0",
    "@vitejs/plugin-react": "6.3.0",
    "d3-contour": "^4.0.3",
    "happy-dom": "^21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "^9.0.0",
    "vgpu": "0.6.0",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
