---
import SiteLayout from "../layouts/site-layout.astro";
import { site } from "../site";
---

<SiteLayout title="Page not found | Foundry" noindex>
  <section class="wrap missing-page">
    <h1>This page isn't here.</h1>
    <p>The address may have changed. Head home to explore Foundry, or find the tools in the documentation.</p>
    <div class="missing-links">
      <a class="button" href="/">Back to Foundry</a>
      <a class="text-link" href={site.docs}>Open documentation</a>
    </div>
  </section>
</SiteLayout>
