{
  "name": "@foundry/works",
  "version": "0.1.0",
  "private": true,
  "description": "Foundry Works desktop application",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "clean": "rm -rf dist .cache .turbo coverage",
    "dev": "electron-vite dev --watch",
    "package": "bun run build && electron-builder --config electron-builder.config.mjs --dir",
    "test": "vitest run",
    "test:electron": "bun run build && bun build ./test/electron/vault-stream.smoke.ts ./test/electron/module-library.smoke.ts ./test/electron/module-preview.smoke.ts ./test/electron/module-build.smoke.ts --target=node --format=cjs --define=import.meta.dirname=SMOKE_MAIN_DIR --banner='const SMOKE_MAIN_DIR = require(\"node:path\").resolve(__dirname, \"../../dist/main\");' --external=electron --external=microsandbox --outdir=.cache/electron --entry-naming='[name].cjs' && bun ./test/electron/run-smoke.ts",
    "test:module-build": "bun run test:electron --build",
    "test:module-runtime": "bun run test:electron --runtime",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foundry/artifacts": "workspace:*",
    "@foundry/authorization": "workspace:*",
    "@foundry/core": "workspace:*",
    "@foundry/lib": "workspace:*",
    "@foundry/modules": "workspace:*",
    "@foundry/sandbox": "workspace:*",
    "@libsql/client": "^0.18.0",
    "@orpc/client": "1.16.4",
    "@orpc/server": "1.16.4",
    "@orpc/tanstack-query": "1.16.4",
    "@pierre/diffs": "1.6.4",
    "@pierre/trees": "1.0.0",
    "@tanstack/react-query": "5.108.2",
    "class-variance-authority": "^0.7.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.77.0",
    "microsandbox": "0.7.16",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "^8.5.2",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@foundry/tsconfig": "workspace:*",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "6.0.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  },
  "productName": "Foundry Works"
}
