{
  "name": "@foundry/works",
  "version": "0.1.0",
  "private": true,
  "description": "Foundry Works desktop application",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "clean": "rm -rf dist .cache .turbo coverage",
    "dev": "electron-vite dev --watch",
    "package": "bun run build && electron-builder --config electron-builder.config.mjs --dir",
    "test": "vitest run",
    "test:electron": "bun run build && bun build ./test/electron/vault-stream.smoke.ts ./test/electron/module-library.smoke.ts ./test/electron/module-preview.smoke.ts --target=node --format=cjs --define=import.meta.dirname=SMOKE_MAIN_DIR --banner='const SMOKE_MAIN_DIR = require(\"node:path\").resolve(__dirname, \"../../dist/main\");' --external=electron --external=microsandbox --outdir=.cache/electron --entry-naming='[name].cjs' && bun ./test/electron/run-smoke.ts",
    "test:module-runtime": "bun run test:electron --runtime",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foundry/artifacts": "workspace:*",
    "@foundry/modules": "workspace:*",
    "@foundry/sandbox": "workspace:*",
    "@orpc/client": "1.15.4",
    "@orpc/server": "1.15.4",
    "@orpc/tanstack-query": "1.15.4",
    "@tanstack/react-query": "5.104.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.49.0",
    "microsandbox": "0.6.18",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@foundry/tsconfig": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.7",
    "electron": "43.7.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.5",
    "happy-dom": "^20.11.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "8.2.2",
    "vitest": "^4.1.9"
  },
  "productName": "Foundry Works"
}
