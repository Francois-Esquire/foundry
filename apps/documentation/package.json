{
  "name": "@foundry/docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf .blume .cache .turbo dist public/spyglass/examples/foundry public/spyglass/scan",
    "dev": "bun run docs:dev",
    "docs:build": "bun scripts/build-example.ts && bun scripts/copy-scan.ts && blume build",
    "docs:check": "blume validate --strict",
    "docs:dev": "bun scripts/build-example.ts && bun scripts/copy-scan.ts && blume dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@foundry.sh/spyglass": "workspace:*",
    "@foundry/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "blume": "1.6.3",
    "happy-dom": "^20.11.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
