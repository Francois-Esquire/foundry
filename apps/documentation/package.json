{
  "name": "@foundry/docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf .blume .cache .turbo dist public/spyglass/examples/foundry",
    "dev": "bun run docs:dev",
    "docs:build": "bun scripts/build-example.ts && blume build",
    "docs:check": "blume validate --strict",
    "docs:dev": "bun scripts/build-example.ts && blume dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@foundry.sh/spyglass": "workspace:*",
    "@foundry/tsconfig": "workspace:*",
    "@types/bun": "1.4.5",
    "blume": "2.2.7",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
