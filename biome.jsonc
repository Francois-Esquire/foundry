{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "linter": {
    "rules": {
      "performance": {
        "noAwaitInLoops": "off"
      },
      "suspicious": {
        "useAwait": "off"
      },
      "style": {
        "useConsistentMethodSignatures": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/atlas/test/lib/fixtures/**",
        "apps/atlas/test/fixtures/atlas.json"
      ],
      "linter": { "enabled": false },
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      "includes": ["tooling/typescript/*.json"],
      "json": {
        "parser": {
          "allowComments": true
        }
      }
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  }
}
