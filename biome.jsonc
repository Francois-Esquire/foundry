{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "linter": {
    "rules": {
      "performance": {
        "noAwaitInLoops": "off"
      },
      "suspicious": {
        "useAwait": "off"
      },
      "style": {
        "useConsistentMethodSignatures": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["tooling/typescript/*.json"],
      "json": {
        "parser": {
          "allowComments": true
        }
      }
    },
    {
      // Tests keep assertion regexes beside the cases they describe.
      "includes": ["packages/*/src/test/**/*.ts", "apps/*/test/**/*.ts"],
      "linter": {
        "rules": {
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  }
}
