{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  // Foundry's own rules, generated by `bun run grit` in tooling/linting. The
  // extension's fixtures and the prompts tests write every notation on
  // purpose, so they are skipped.
  "plugins": [
    {
      "path": "./tooling/linting/biome/prompts-consumed-by-harness.grit",
      "includes": [
        "**",
        "!**/tooling/vscode-extension/fixtures/**",
        "!**/packages/prompts/src/test/**",
        "!**/packages/agents/src/test/**"
      ]
    },
    {
      "path": "./tooling/linting/biome/prompts-template-only.grit",
      "includes": [
        "**",
        "!**/tooling/vscode-extension/fixtures/**",
        "!**/packages/prompts/src/test/**",
        "!**/packages/agents/src/test/**"
      ]
    }
  ],
  "linter": {
    "rules": {
      "performance": {
        "noAwaitInLoops": "off"
      },
      "suspicious": {
        "useAwait": "off"
      },
      "style": {
        "useConsistentMethodSignatures": "off"
      }
    }
  },
  "overrides": [
    {
      // Generated GritQL; `bun run grit` in tooling/linting owns its shape.
      "includes": ["tooling/linting/biome/**"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      "includes": [
        "apps/spyglass/test/lib/fixtures/**",
        "apps/spyglass/test/fixtures/spyglass.json"
      ],
      "linter": { "enabled": false },
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      // The viewer bundles these for the browser: Spyglass's dataset reader and
      // layout, the types modules it reads through, and the viewer itself.
      "includes": [
        "apps/spyglass/src/lib/dataset.ts",
        "apps/spyglass/src/lib/dataset-layout.ts",
        "apps/spyglass/src/lib/*-types.ts",
        "apps/spyglass/src/lib/lenses/*-types.ts",
        "apps/spyglass/src/lib/lenses/package-internals.ts",
        "apps/spyglass/src/web/**"
      ],
      "linter": {
        "rules": { "correctness": { "noNodejsModules": "error" } }
      }
    },
    {
      // Biome lints only the frontmatter of an Astro file; bindings used in the
      // template below it read as unused. Astro's own check covers the template.
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["tooling/typescript/*.json"],
      "json": {
        "parser": {
          "allowComments": true
        }
      }
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  }
}
