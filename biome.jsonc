{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "plugins": [
    {
      "path": "./tooling/linting/biome/prompts-consumed-by-harness.grit",
      "includes": [
        "**",
        "!**/tooling/vscode-extension/fixtures/**",
        "!**/packages/prompts/src/test/**",
        "!**/packages/agents/src/test/prompts.test.ts"
      ]
    },
    {
      "path": "./tooling/linting/biome/prompts-template-only.grit",
      "includes": [
        "**",
        "!**/tooling/vscode-extension/fixtures/**",
        "!**/packages/prompts/src/test/**",
        "!**/packages/agents/src/test/prompts.test.ts"
      ]
    }
  ],
  "linter": {
    "rules": {
      "performance": {
        "noAwaitInLoops": "off"
      },
      "suspicious": {
        "useAwait": "off"
      },
      "style": {
        "useConsistentMethodSignatures": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/spyglass/src/web/scene/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "document": "UI DOM belongs in src/web/ui/."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["tooling/linting/biome/**"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      "includes": ["apps/marbles/src/database/migrations/**"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      "includes": [
        "apps/spyglass/test/lib/fixtures/**",
        "apps/spyglass/test/fixtures/spyglass.json"
      ],
      "linter": { "enabled": false },
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      "includes": [
        "apps/spyglass/src/lib/dataset.ts",
        "apps/spyglass/src/lib/dataset-layout.ts",
        "apps/spyglass/src/lib/*-types.ts",
        "apps/spyglass/src/lib/lenses/*-types.ts",
        "apps/spyglass/src/lib/lenses/package-internals.ts",
        "apps/spyglass/src/web/**"
      ],
      "linter": {
        "rules": { "correctness": { "noNodejsModules": "error" } }
      }
    },
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["tooling/typescript/*.json"],
      "json": {
        "parser": {
          "allowComments": true
        }
      }
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  }
}
