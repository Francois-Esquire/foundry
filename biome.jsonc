{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "linter": {
    "rules": {
      "performance": {
        "noAwaitInLoops": "off"
      },
      "suspicious": {
        "useAwait": "off"
      },
      "style": {
        "useConsistentMethodSignatures": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/atlas/test/lib/fixtures/**",
        "apps/atlas/test/fixtures/atlas.json"
      ],
      "linter": { "enabled": false },
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      // The viewer bundles these for the browser: Atlas's dataset reader and
      // layout, the types modules it reads through, and the viewer itself.
      "includes": [
        "apps/atlas/src/lib/dataset.ts",
        "apps/atlas/src/lib/dataset-layout.ts",
        "apps/atlas/src/lib/*-types.ts",
        "apps/atlas/src/lib/lenses/*-types.ts",
        "apps/atlas/src/web/**"
      ],
      "linter": {
        "rules": { "correctness": { "noNodejsModules": "error" } }
      }
    },
    {
      // Biome lints only the frontmatter of an Astro file; bindings used in the
      // template below it read as unused. Astro's own check covers the template.
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["tooling/typescript/*.json"],
      "json": {
        "parser": {
          "allowComments": true
        }
      }
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  }
}
