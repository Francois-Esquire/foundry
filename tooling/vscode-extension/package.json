{
  "name": "foundry-prompts",
  "displayName": "Foundry Prompts",
  "version": "0.0.0",
  "private": true,
  "description": "Highlights what a prompt references (skills, agents, files, arguments, commands) inside prompts tags and Claude skill files.",
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Francois-Esquire/foundry.git",
    "directory": "tooling/vscode-extension"
  },
  "license": "MIT",
  "publisher": "foundry",
  "type": "module",
  "scripts": {
    "build": "mkdir -p dist && vsce package --no-dependencies --skip-license --baseImagesUrl https://github.com/Francois-Esquire/foundry/raw/HEAD/tooling/vscode-extension --out dist/foundry-prompts.vsix",
    "clean": "rm -rf .cache .turbo coverage dist",
    "editor:install": "code --install-extension dist/foundry-prompts.vsix --force",
    "grammar": "bun scripts/grammar.ts && biome format --write syntaxes",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "contributes": {
    "grammars": [
      {
        "scopeName": "text.prompt",
        "path": "./syntaxes/prompt.tmLanguage.json"
      },
      {
        "scopeName": "inline.prompts.typescript",
        "path": "./syntaxes/prompts.typescript.tmLanguage.json",
        "injectTo": [
          "source.ts",
          "source.tsx",
          "source.js",
          "source.js.jsx"
        ]
      },
      {
        "scopeName": "inline.prompts.markdown",
        "path": "./syntaxes/prompts.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown.prompt"
        ]
      }
    ]
  },
  "devDependencies": {
    "@foundry/prompts": "workspace:*",
    "@foundry/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "@vitest/coverage-v8": "^4.1.9",
    "@vscode/vsce": "4.0.0",
    "shiki": "^4.4.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "vscode": "^1.99.0"
  }
}
