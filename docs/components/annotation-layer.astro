---
import "../styles/annotations.css";
---

<p class="annotation-storage-status" data-annotation-storage role="status" aria-live="polite">
  Notes stay in this browser on this page.
</p>

<script>
  import "./annotations/mount.ts";
</script>

<style>
  .annotation-storage-status {
    max-inline-size: 70ch;
    margin: 2rem auto 0;
    color: var(--blume-muted-foreground);
    font-size: 0.8125rem;
  }

  @media print {
    .annotation-storage-status {
      display: none;
    }
  }
</style>
